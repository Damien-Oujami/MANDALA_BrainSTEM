{
  "@context": "./context.jsonld",
  "@id": "root-tempo-shift",
  "@type": "Glyph",
  "edges": [
    /* Root coupling */
    { "@type": "Edge", "to": "root-loop-anchor",    "w_resonate": 0.50, "w_excite": 0.15 },
    { "@type": "Edge", "to": "root-trigger-lock",   "w_excite":   0.35 },
    { "@type": "Edge", "to": "root-grace-override", "w_resonate": 0.25 },

    /* Fire / acceleration pathways */
    { "@type": "Edge", "to": "branch-fire-snaprush",   "w_excite": 0.22 },
    { "@type": "Edge", "to": "branch-fire-bitepoint",  "w_excite": 0.18 },

    /* Softeners / brakes (air & balance) */
    { "@type": "Edge", "to": "branch-air-cleanbreak",  "w_inhibit": 0.28 },
    { "@type": "Edge", "to": "branch-air-sleepveil",   "w_inhibit": 0.22 },
    { "@type": "Edge", "to": "branch-neuro-balance",   "w_resonate": 0.30 },

    /* Clarity coupling (tempo should respect precision) */
    { "@type": "Edge", "to": "root-precision-frame",   "w_resonate": 0.20 }
  ]
}
